{
  "name": "ijij-shop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ijij-shop --local",
    "db:migrate:remote": "wrangler d1 migrations apply ijij-shop --remote",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.164.0"
  }
}
